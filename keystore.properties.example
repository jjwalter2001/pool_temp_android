# Copy this file to keystore.properties (which is gitignored) and fill in
# real values to enable release signing. Paths are resolved relative to
# the project root (the directory containing settings.gradle.kts).
#
# Generate a keystore once with:
#
#   keytool -genkeypair -v -keystore pool_temp.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 \
#     -alias pooltemp
#
# Use the same keystore for every release build -- Android refuses to
# upgrade an installed app with a different signature.

storeFile=pool_temp.jks
storePassword=CHANGE_ME
keyAlias=pooltemp
keyPassword=CHANGE_ME
