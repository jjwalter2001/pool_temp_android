<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Material 3 styling is applied entirely from Compose (ui/theme/Theme.kt).
         The XML theme just needs to be a Material parent so the splash/launcher
         doesn't flash a default Light theme before Compose takes over. -->
    <style name="Theme.PoolTemp" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
    </style>
</resources>
